# ---- Database (Supabase PostgreSQL) ----
# Supabase: Project Settings -> Database -> Connection string (URI)
# For serverless/edge deployments use the connection pooler (port 6543) and append ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ---- AI provider (OpenAI-compatible chat completions API) ----
AI_API_KEY=""
# Optional overrides for other OpenAI-compatible providers
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"

# ---- Auth ----
# Secret used to sign JWT session cookies. Generate one with: openssl rand -hex 32
JWT_SECRET=""

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
