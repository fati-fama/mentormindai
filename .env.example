# ---- Database (Supabase PostgreSQL) ----
# Supabase: Project Settings -> Database -> Connection string (URI)
# For serverless/edge deployments use the connection pooler (port 6543) and append ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ---- AI providers (at least one key required) ----
# The mentor tries providers in order: OpenAI → Groq → Gemini.
# Configure at least one. All use their free/cheap tiers for development.
OPENAI_API_KEY=""
# Optional: override default model (gpt-4o-mini)
# OPENAI_MODEL="gpt-4o-mini"

GROQ_API_KEY=""
# Optional: override default model (llama-3.3-70b-versatile)
# GROQ_MODEL="llama-3.3-70b-versatile"

GEMINI_API_KEY=""
# Optional: override default model (gemini-2.0-flash)
# GEMINI_MODEL="gemini-2.0-flash"

# Legacy single-key support (OpenAI-compatible endpoint)
AI_API_KEY=""
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"

# ---- Auth ----
# Secret used to sign JWT session cookies. Generate one with: openssl rand -hex 32
JWT_SECRET=""

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
